# Conexão usada pelo app em runtime (pooler do Supabase)
DATABASE_URL="postgresql://postgres.REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Conexão direta, usada por `prisma migrate` e `prisma studio`.
# O pooler em transaction mode nao suporta DDL nem advisory lock.
DIRECT_DATABASE_URL="postgresql://postgres.REF:SENHA@db.REF.supabase.co:5432/postgres"

# Chave de assinatura dos tokens JWT (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres"

# Origens autorizadas a chamar a API (separadas por virgula)
ALLOWED_ORIGINS="http://localhost:5000"

# Credenciais criadas por `npm run db:seed`
SEED_ADMIN_EMAIL="admin@memorial.com"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Supabase Storage (imagens de falecidos)
SUPABASE_URL="https://jyozoocwfedxlxkmdztw.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_sua_chave_secreta_aqui"